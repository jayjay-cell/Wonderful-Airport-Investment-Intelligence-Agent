# LLM providers, tried in order with automatic fallback on rate limit/quota/
# timeout: Gemini -> Groq -> OpenRouter (see agent/providers.py). At least
# one key is required. Gemini is also required for research_airport_facts_tool
# (Google Search grounding) — without it, research questions return an
# explicit limitation instead of an answer.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# No other configuration is required. Conversation state uses an in-memory
# store; session_id is generated server-side and treated as unguessable.
