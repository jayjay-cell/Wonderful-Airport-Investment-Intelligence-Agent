# LLM providers — routed by task type, with fallback (see agent/executor.py).
# Free tiers are sufficient for this project. Leave any key blank to disable
# that provider in the routing/fallback chain.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Session store secret is not required for the in-memory dict store used in
# this MVP; session_id is generated server-side and treated as unguessable.

# Optional: force offline/demo-snapshot mode instead of live data calls.
# DEMO_MODE=false
